# LLM: Groq free tier — get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-120b

# Exasol Personal connection.
# Local dev (docker): see docker-compose.exasol.yml -> 127.0.0.1:8563, sys/exasol
# Personal (AWS/Azure): use `exasol info` for host and credentials.
EXASOL_ENABLED=false
EXASOL_DSN=your-exasol-host:8563
EXASOL_USER=sys
EXASOL_PASSWORD=your_exasol_password_here
EXASOL_SCHEMA=ARIA
EXASOL_ENCRYPTION=true
EXASOL_CERT_VERIFY=false
